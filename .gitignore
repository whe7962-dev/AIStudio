# =============================================================
# 根目录 .gitignore —— 公开仓库，敏感/垃圾文件一律不入库
# =============================================================

# 密钥与本地环境：真实 key 永不入库、不进 git、不进日志
demo-api.env
.env
.env.*
!.env.example

# 历史备份 / 交付包 zip（本地归档用，不入库）
*.zip

# Python 运行环境与缓存
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 运行时数据（项目图、资产库、生成图/视频、journal、导出物）
data/
outputs/
tmp/

# 运行日志（含本地路径等隐私信息）
*.log

# 系统文件
.DS_Store
