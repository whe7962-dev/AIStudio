# =============================================================
# 端侧AIStudio 后端骨架 —— 环境变量示例
# 复制为 .env 使用；真实密钥绝不入库、不进 git、不进日志。
# =============================================================

# ---- 服务 ----
AISIDE_HOST=127.0.0.1
AISIDE_PORT=8765
# 数据目录（项目图、资产库、job journal、导出物），默认 ./data
AISIDE_DATA_DIR=./data

# ---- 推理 provider 选择 ----
# stub  = 本地桩（离线、无需密钥，用于跑通骨架与测试）
# seedream = 豆包 Seedream（仅 demo 期验证链路；正式版切本地，见 README）
AISIDE_PROVIDER=stub

# ---- demo 期豆包 Seedream（火山方舟 Ark）----
# 真实 key 在 ../demo-api.env（out/端侧AIStudio/demo-api.env），不入库、不进 PRD。
# 也可在启动前 export；优先级：环境变量 > demo-api.env > .env。
# DEMO_BASE_URL=https://ark.cn-beijing.volces.com
# DEMO_API_KEY=
# DEMO_KIND=ark
# DEMO_MODEL_DRAFT=doubao-seedream-5-0-flash-260915
# DEMO_MODEL_FINAL=doubao-seedream-5-0-pro-260628
# DEMO_MODEL_EDIT=doubao-seededit-3-0-i2i-250628

# ---- 理解层 LLM（OpenAI 兼容，可选）----
# 正式版指向本地 Qwen3（Ollama / LM Studio / MLX server）。不配则 Agent Loop 不启用。
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b

# ---- 网络出口白名单（域名，逗号分隔；仅允许这些域名的出网请求）----
# 默认仅放行 demo 生图 API 域名；其余一律拒绝（默认不出网红线）。
AISIDE_NETWORK_ALLOWLIST=

# ---- 真实视频：千问AI Wan3.0-Video-Prime ----
# 密钥仅放 ../demo-api.env 或环境变量。以下示例不含真实凭据。
# DASHSCOPE_API_KEY=
# VIDEO_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1
# VIDEO_MODEL=wan3.0-video-prime
